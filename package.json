{
  "name": "gigis-long-branch-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Gigi's NY Style Pizza \u2014 Long Branch location website",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/prune-static-menu.mjs && python3 scripts/build-menu-page.py",
    "prune-menu": "node scripts/prune-static-menu.mjs",
    "build": "python3 scripts/verify-prices.py && tsc -b && tsc -p tsconfig.api.json --noEmit && vite-react-ssg build && node scripts/verify-csp-build.mjs",
    "preview": "vite preview --host",
    "lint": "eslint . && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.api.json --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "verify:prices": "python3 scripts/verify-prices.py"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vercel/node": "^3.2.29",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.0.5",
    "vite-react-ssg": "^0.9.1"
  }
}
